{
  "displayName": "Enforce - Cost Tags",
  "policyType": "Custom",
  "mode": "Indexed",
  "metadata": {
    "description": "Require cost tags with allowed values"
  },

  "parameters": {

    "allowedApplications": {
      "type": "Array",
      "metadata": {
        "displayName": "Allowed Applications"
      },
      "allowedValues": [
        "App1",
        "App2",
        "App3"
      ]
    },

    "allowedEnvironments": {
      "type": "Array",
      "metadata": {
        "displayName": "Allowed Environments"
      },
      "allowedValues": [
        "Prod",
        "Dev",
        "Test",
        "QA"
      ]
    },

    "allowedBudget": {
      "type": "Array",
      "metadata": {
        "displayName": "Allowed Budget Values"
      },
      "allowedValues": [
        "Required",
        "NotRequired"
      ]
    },

    "allowedCostCenter": {
      "type": "Array",
      "metadata": {
        "displayName": "Allowed Cost Centers"
      },
      "allowedValues": [
        "IT",
        "Finance",
        "HR",
        "Marketing"
      ]
    }

  },

  "policyRule": {
    "if": {
      "anyOf": [

        {
          "field": "tags['Application']",
          "exists": false
        },
        {
          "field": "tags['Application']",
          "notIn": "[parameters('allowedApplications')]"
        },

        {
          "field": "tags['Environment']",
          "exists": false
        },
        {
          "field": "tags['Environment']",
          "notIn": "[parameters('allowedEnvironments')]"
        },

        {
          "field": "tags['Budget']",
          "exists": false
        },
        {
          "field": "tags['Budget']",
          "notIn": "[parameters('allowedBudget')]"
        },

        {
          "field": "tags['CostCenter']",
          "exists": false
        },
        {
          "field": "tags['CostCenter']",
          "notIn": "[parameters('allowedCostCenter')]"
        }

      ]
    },
    "then": {
      "effect": "deny"
    }
  }
}
